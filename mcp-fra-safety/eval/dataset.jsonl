{"id": "eval_13_walk_across_forms", "category": "Cross-Form Walk (Forms 54, 57 & 55a)", "tool": "walk_across_fra_forms", "args": {"state": "TX", "start_year": 2022, "end_year": 2024, "only_multi_form": true, "limit": 5}, "checks": {"required_keys": ["walk_summary", "form_54_train_accidents", "form_57_grade_crossings", "form_55a_individual_casualties"], "not_null_paths": ["walk_summary.truncated", "walk_summary.truncation_note"], "non_empty_list": ["form_54_train_accidents"]}}
{"id": "eval_14_custom_cross_form_sql", "category": "Ad-Hoc Cross-Form SQL Join (54 + 55a + 57)", "tool": "run_fra_sql_query", "args": {"sql": "SELECT f.reportingrailroadcode, f.year, f.incidentkey, f.station, COUNT(DISTINCT a.reportkey) AS linked_55a_casualties, MAX(x.gradecrossingid) AS linked_57_crossing_id FROM form_54_accidents f LEFT JOIN form_55a_casualties a ON f.incidentkey = a.incidentkey LEFT JOIN form_57_crossings x ON f.gxid = x.gradecrossingid AND CAST(f.date AS DATE) = CAST(x.date AS DATE) WHERE f.jointcd = '1' AND f.year BETWEEN 2022 AND 2024 GROUP BY f.reportingrailroadcode, f.year, f.incidentkey, f.station HAVING COUNT(DISTINCT a.reportkey) > 0", "limit": 10}, "checks": {"required_keys": ["row_count", "truncated", "truncation_note", "columns", "rows"], "not_null_paths": ["truncated", "truncation_note"], "non_empty_list": ["rows"]}}
{"id": "eval_15_stb_1246_employment", "category": "STB Part 1246 Class I Employment & AAR Crosswalk", "tool": "analyze_class1_employment_and_safety", "args": {"start_year": 2020, "end_year": 2025, "railroad_code": "CSXT"}, "checks": {"required_keys": ["total_avg_monthly_employees", "carrier_employment_summary", "craft_breakdown_l100_to_l600", "cross_form_fra_safety_rates"], "non_empty_list": ["carrier_employment_summary", "craft_breakdown_l100_to_l600"]}}
{"id": "eval_16_stb_fra_cross_sql", "category": "STB 1246 + FRA Form 54 Cross-Agency SQL Join", "tool": "run_fra_sql_query", "args": {"sql": "SELECT UPPER(TRIM(railroad_aar_reporting_mark)) AS stb_mark, COUNT(*) AS stat_rows, ROUND(AVG(TRY_CAST(fact_value AS DOUBLE)), 1) AS avg_val FROM stb_1246_all_carriers WHERE UPPER(TRIM(measure_name)) LIKE '%MID%' GROUP BY 1 ORDER BY stat_rows DESC", "limit": 10}, "checks": {"required_keys": ["row_count", "truncated", "rows"], "non_empty_list": ["rows"]}}